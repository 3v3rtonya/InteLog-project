# ============================================================
# Intern Management System - Backend Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# --- Database ---
# PostgreSQL connection string
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/intern_mis

# --- JWT Security ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-use-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Google OAuth2 ---
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Set Authorized redirect URI to: http://localhost:5173/auth/google/callback
GOOGLE_CLIENT_ID=GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback

# --- SMTP Email ---
# For Gmail: enable "App Passwords" in Google Account settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@mis.local
SMTP_USE_TLS=True

# --- Application ---
FRONTEND_URL=http://localhost:5173
UPLOAD_DIR=uploads
MAX_IMAGE_SIZE_MB=5
MAX_IMAGES_PER_LOG=3

# --- Rate Limiting ---
RATE_LIMIT_AUTH=10/minute
